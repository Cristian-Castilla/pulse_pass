# PulsePass — plantilla de variables de entorno
#
# PRD de Seguridad §14.2: "No subir un secreto real a .env versionado ni a application.yml.
# Documentar una plantilla .env.example sin secreto".
#
# Copiar este archivo a `.env.properties` y completar los valores.
#
#   cp .env.example .env.properties
#
# El nombre del archivo importa y no es opcional:
#
#   application.yml importa `optional:file:.env.properties`. Spring Boot elige el loader de
#   propiedades según la EXTENSIÓN del archivo, y `.properties` es una de las extensiones que
#   reconoce (`PropertiesPropertySourceLoader`). Un archivo llamado `.env` (sin extensión
#   conocida) NO se carga por `spring.config.import`: Boot no sabe qué loader usar, así que las
#   variables quedan sin resolver y la aplicación falla al arrancar con
#   "pulsepass.security.jwt.secret-base64 is required".
#
# `.env.properties` está excluido del repositorio (ver .gitignore: `.env*`). La clave NO debe
# commitearse: PRD §8 SEC-004.

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/pulsepass
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------

# Emisor del token. Debe coincidir con el issuer que valida JwtServiceImpl (PRD §12.1).
PULSEPASS_JWT_ISSUER=pulsepass-api

# Clave secreta en Base64. Requisitos (PRD §12.3):
#   - al menos 32 bytes aleatorios (se recomiendan 48)
#   - codificada en Base64
#   - generada con una fuente de aleatoriedad criptográficamente segura
#
# Generar una clave:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   bash:       head -c 48 /dev/urandom | base64
#
# Sin este valor la aplicación no arranca: JwtServiceImpl lo exige.
PULSEPASS_JWT_SECRET_BASE64=

# Vida del token de acceso. Formato ISO-8601 Duration (PRD §10.1: 900 segundos = PT15M).
PULSEPASS_JWT_ACCESS_TOKEN_TTL=PT15M
